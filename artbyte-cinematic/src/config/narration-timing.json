  "phrases": [
    {
      "start": 0.22,
      "end": 0.98,
      "text": "عندك صيدلية؟",
      "scene": "traditional-pharmacy",
      "emphasis": [{ "t": 0.55, "word": "صيدلية" }]
    },
    {
      "start": 1.54,
      "end": 6.60,
      "text": "هل فكرت يوماً كم تخسر شهرياً بسبب تفاصيل صغيرة تمر أمام عينيك كل يوم؟",
      "scene": "traditional-pharmacy",
      "emphasis": [
        { "t": 2.95, "word": "تخسر شهرياً" },
        { "t": 4.90, "word": "تفاصيل صغيرة" }
      ]
    },
    {
      "start": 7.42,
      "end": 9.26,
      "text": "تخيل أن الزبون يقف أمامك الآن،",
      "scene": "traditional-pharmacy",
      "emphasis": [{ "t": 8.15, "word": "الزبون" }]
    },
    {
      "start": 9.70,
      "end": 11.68,
      "text": "تمد يدك إلى الرف لتعطيه الدواء،",
      "scene": "traditional-pharmacy",
      "emphasis": [
        { "t": 10.25, "word": "الرف" },
        { "t": 11.20, "word": "الدواء" }
      ]
    },
    {
      "start": 12.42,
      "end": 14.92,
      "text": "فتصدم بأن العلبة قد انتهت صلاحيتها!",
      "scene": "medicine-search",
      "emphasis": [{ "t": 14.10, "word": "انتهت صلاحيتها" }]
    },
    {
      "start": 15.66,
      "end": 19.48,
      "text": "والأسوأ من ذلك أن بجانبها عبوات أخرى من دفعات مختلفة،",
      "scene": "medicine-search",
      "emphasis": [{ "t": 18.60, "word": "دفعات مختلفة" }]
    },
    {
      "start": 20.26,
      "end": 23.84,
      "text": "لا تدري أيها الأقدم، وما الكمية المتبقية من كل دفعة،",
      "scene": "medicine-search",
      "emphasis": [
        { "t": 21.10, "word": "الأقدم" },
        { "t": 22.85, "word": "الكمية المتبقية" }
      ]
    },
    {
      "start": 24.36,
      "end": 25.94,
      "text": "وأيها يجب صرفه أولاً.",
      "scene": "medicine-search",
      "emphasis": [{ "t": 25.45, "word": "أولاً" }]
    },
    {
      "start": 26.66,
      "end": 31.24,
      "text": "هذا الموقف لا يحدث مرة واحدة، بل قد يتكرر مع عشرات الأصناف يومياً،",
      "scene": "medicine-search",
      "emphasis": [{ "t": 29.85, "word": "عشرات الأصناف يومياً" }]
    },
    {
      "start": 31.72,
      "end": 36.64,
      "text": "لتكتشف في نهاية الشهر حجم الخسائر التي تسللت إلى صيدليتك بصمت.",
      "scene": "medicine-search",
      "emphasis": [
        { "t": 33.10, "word": "نهاية الشهر" },
        { "t": 34.40, "word": "حجم الخسائر" }
      ]
    },
    {
      "start": 37.48,
      "end": 41.70,
      "text": "إن إدارة الصيدلية اليوم ليست مجرد عمليات بيع وشراء يومية،",
      "scene": "accounting-nightmare",
      "emphasis": [{ "t": 40.20, "word": "بيع وشراء يومية" }]
    },
    {
      "start": 42.30,
      "end": 48.26,
      "text": "إنها متابعة دقيقة للمخزون والدفعات وتواريخ الصلاحية والمبيعات والحسابات.",
      "scene": "accounting-nightmare",
      "words": [
        { "start": 43.30, "end": 44.30, "text": "للمخزون" },
        { "start": 44.30, "end": 45.28, "text": "والدفعات" },
        { "start": 45.28, "end": 46.50, "text": "وتواريخ الصلاحية" },
        { "start": 46.50, "end": 47.42, "text": "والمبيعات" },
        { "start": 47.42, "end": 48.26, "text": "والحسابات" }
      ]
    },
    {
      "start": 49.10,
      "end": 54.26,
      "text": "ولهذا لم تعد الدفاتر والجداول الورقية كافية لمواكبة هذا الضغط.",
      "scene": "accounting-nightmare",
      "emphasis": [{ "t": 50.65, "word": "الدفاتر والجداول الورقية" }]
    },
    {
      "start": 54.86,
      "end": 60.02,
      "text": "أنت بحاجة إلى نظام ذكي يجمع كل تفاصيل صيدليتك في مكان واحد.",
      "scene": "accounting-nightmare",
      "emphasis": [
        { "t": 56.10, "word": "نظام ذكي" },
        { "t": 59.10, "word": "مكان واحد" }
      ]
    },
    {
      "start": 60.92,
      "end": 63.90,
      "text": "نقدم لك نظاماً متكاملاً لإدارة الصيدليات،",
      "scene": "artbyte-arrival",
      "emphasis": [{ "t": 62.10, "word": "نظاماً متكاملاً" }]
    },
    {
      "start": 64.18,
      "end": 68.36,
      "text": "صُمم خصيصاً ليجعل عملك أكثر تنظيماً ووضوحاً.",
      "scene": "artbyte-arrival",
      "emphasis": [{ "t": 67.20, "word": "تنظيماً ووضوحاً" }]
    },
    {
      "start": 69.08,
      "end": 71.10,
      "text": "تابع جميع الأدوية والأصناف بدقة،",
      "scene": "digital-transformation",
      "emphasis": [{ "t": 70.10, "word": "الأدوية والأصناف" }]
    },
    {
      "start": 71.60,
      "end": 74.06,
      "text": "واعرف الكميات المتوفرة لديك في كل لحظة،",
      "scene": "digital-transformation",
      "emphasis": [{ "t": 72.40, "word": "الكميات المتوفرة" }]
    },
    {
      "start": 74.46,
      "end": 76.88,
      "text": "وأدر دفعات كل دواء بشكل مستقل.",
      "scene": "digital-transformation",
      "emphasis": [{ "t": 75.35, "word": "دفعات كل دواء" }]
    },
    {
      "start": 77.52,
      "end": 80.24,
      "text": "راقب تواريخ انتهاء الصلاحية أولاً بأول،",
      "scene": "digital-transformation",
      "emphasis": [{ "t": 78.60, "word": "تواريخ انتهاء الصلاحية" }]
    },
    {
      "start": 80.62,
      "end": 85.50,
      "text": "وتعرف على الدفعات التي اقترب موعد انتهائها وعدد الأيام المتبقية لكل منها.",
      "scene": "digital-transformation",
      "emphasis": [{ "t": 84.10, "word": "عدد الأيام المتبقية" }]
    },
    {
      "start": 86.06,
      "end": 86.84,
      "text": "وليس هذا فحسب،",
      "scene": "batch-label-printing"
    },
    {
      "start": 87.62,
      "end": 91.56,
      "text": "بل يمكنك أيضاً طباعة ملصقات خاصة بكل دفعة،",
      "scene": "batch-label-printing",
      "emphasis": [{ "t": 89.40, "word": "طباعة ملصقات" }]
    },
    {
      "start": 92.04,
      "end": 94.86,
      "text": "تتضمن بيانات الدواء وتاريخ الصلاحية،",
      "scene": "batch-label-printing",
      "emphasis": [{ "t": 93.40, "word": "بيانات الدواء وتاريخ الصلاحية" }]
    },
    {
      "start": 95.32,
      "end": 99.00,
      "text": "لتضعها مباشرة على عبواتك ورفوف الصيدلية،",
      "scene": "batch-label-printing",
      "emphasis": [{ "t": 97.60, "word": "عبواتك ورفوف الصيدلية" }]
    },
    {
      "start": 99.68,
      "end": 105.96,
      "text": "فتودع البحث العشوائي، وتعرف بنظرة واحدة أي عبوة يجب صرفها أولاً.",
      "scene": "batch-label-printing",
      "emphasis": [
        { "t": 100.80, "word": "البحث العشوائي" },
        { "t": 104.80, "word": "صرفها أولاً" }
      ]
    },
    {
      "start": 107.06,
      "end": 110.44,
      "text": "ولأن إدارة الصيدلية لا تكتمل بالمخزون وحده،",
      "scene": "financial-management"
    },
    {
      "start": 111.00,
      "end": 114.66,
      "text": "يمنحك النظام إدارة مالية ومحاسبية شاملة،",
      "scene": "financial-management",
      "emphasis": [{ "t": 113.20, "word": "إدارة مالية ومحاسبية شاملة" }]
    },
    {
      "start": 115.26,
      "end": 118.06,
      "text": "تبدأ من شجرة الحسابات والقيود اليومية،",
      "scene": "financial-management",
      "words": [
        { "start": 115.80, "end": 116.85, "text": "شجرة الحسابات" },
        { "start": 116.85, "end": 118.06, "text": "والقيود اليومية" }
      ]
    },
    {
      "start": 118.56,
      "end": 123.02,
      "text": "وتمتد إلى الصندوق والبنوك وحسابات العملاء والموردين،",
      "scene": "financial-management",
      "words": [
        { "start": 119.30, "end": 120.70, "text": "الصندوق والبنوك" },
        { "start": 120.70, "end": 123.02, "text": "وحسابات العملاء والموردين" }
      ]
    },
    {
      "start": 123.62,
      "end": 126.76,
      "text": "مع متابعة دقيقة للمبيعات وتكاليفها،",
      "scene": "financial-management",
      "emphasis": [{ "t": 125.40, "word": "المبيعات وتكاليفها" }]
    },
    {
      "start": 127.24,
      "end": 129.34,
      "text": "وتسجيل جميع الحركات المالية،",
      "scene": "financial-management"
    },
    {
      "start": 129.84,
      "end": 134.58,
      "text": "لتتمكن من الرجوع إليها ومراجعتها بكل سهولة وشفافية.",
      "scene": "financial-management",
      "emphasis": [{ "t": 133.40, "word": "سهولة وشفافية" }]
    },
    {
      "start": 135.48,
      "end": 138.74,
      "text": "ولأن عملك لا يتوقف بمجرد مغادرتك للصيدلية،",
      "scene": "mobile-management"
    },
    {
      "start": 139.28,
      "end": 146.70,
      "text": "يمكنك متابعة كافة تفاصيل أعمالك من خلال تطبيق الموبايل المتاح على جوجل بلاي أينما كنت.",
      "scene": "mobile-management",
      "words": [
        { "start": 141.90, "end": 143.60, "text": "تطبيق الموبايل" },
        { "start": 143.60, "end": 145.30, "text": "جوجل بلاي" },
        { "start": 145.80, "end": 146.70, "text": "أينما كنت" }
      ]
    },
    {
      "start": 147.20,
      "end": 149.88,
      "text": "كما يمكنك الدخول إلى النظام عبر الحاسوب،",
      "scene": "mobile-management",
      "emphasis": [{ "t": 148.90, "word": "عبر الحاسوب" }]
    },
    {
      "start": 150.36,
      "end": 156.88,
      "text": "والاستفادة من شاشة أكبر لإدارة ومراجعة جميع عملياتك بأعلى درجات الراحة والدقة.",
      "scene": "mobile-management",
      "emphasis": [
        { "start": 151.60, "end": 152.60, "text": "شاشة أكبر" },
        { "start": 155.30, "end": 156.88, "text": "الراحة والدقة" }
      ]
    },
    {
      "start": 157.58,
      "end": 160.20,
      "text": "لكن امتلاك نظام قوي ليس كل شيء؛",
      "scene": "technical-support"
    },
    {
      "start": 160.78,
      "end": 168.32,
      "text": "الأهم هو أن تجد فريقاً تقنياً يقف معك، يتابع عملك ويقدم لك الدعم الحقيقي متى احتجت إليه.",
      "scene": "technical-support",
      "emphasis": [
        { "t": 162.10, "word": "فريقاً تقنياً يقف معك" },
        { "t": 165.40, "word": "الدعم الحقيقي" }
      ]
    },
    {
      "start": 169.30,
      "end": 175.00,
      "text": "وهنا تأتي آرت بايت، بخبرة تتجاوز عشر سنوات في تطوير وتنفيذ الأنظمة التقنية،",
      "scene": "technical-support",
      "emphasis": [
        { "t": 170.00, "word": "آرت بايت" },
        { "t": 171.60, "word": "عشر سنوات" }
      ]
    },
    {
      "start": 175.56,
      "end": 180.08,
      "text": "وتجارب عملية راسخة في بناء الحلول ومتابعة تشغيلها وتطويرها.",
      "scene": "technical-support"
    },
    {
      "start": 180.82,
      "end": 183.48,
      "text": "نحن لا نبيعك برنامجاً ثم نختفي بعد البيع؛",
      "scene": "brand-reveal"
    },
    {
      "start": 184.06,
      "end": 187.00,
      "text": "هاتفنا متاح دائماً، ونحن قريبون منك،",
      "scene": "brand-reveal",
      "emphasis": [{ "t": 184.70, "word": "هاتفنا متاح دائماً" }]
    },
    {
      "start": 187.58,
      "end": 192.20,
      "text": "لأننا نهتم باستقرار عملك بنفس اهتمامنا بضمان حقوقنا المالية.",
      "scene": "brand-reveal",
      "emphasis": [{ "t": 188.90, "word": "استقرار عملك" }]
    }
  ]
}
